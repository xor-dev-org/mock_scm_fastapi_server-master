# Sync (psycopg2) connection string used by the LangChain SQL agent.
DATABASE_URI=postgresql+psycopg2://postgres:password@localhost:5432/pai

# Azure OpenAI - required for the SQL agent (app/services/sql_agent_service.py).
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT_NAME=
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# Azure Communication Services - optional, falls back to local mode if unset.
ACS_CONNECTION_STRING=
AZURE_COMMUNICATION_CONNECTION_STRING=
AZURE_COMMUNICATION_ENDPOINT=

# Azure SignalR - optional.
AZURE_SIGNALR_ENDPOINT=
AZURE_SIGNALR_HUB=procurementchat
AZURE_SIGNALR_ACCESS_KEY=

# Upload storage path for PO documents.
UPLOAD_STORAGE_PATH=data/uploads
